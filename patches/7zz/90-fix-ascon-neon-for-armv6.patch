 static Z7_FORCE_INLINE void AsconEncBlock_NEON(UInt64 state[5], Byte *data)
 {
@@ -85,6 +86,31 @@
   state[1] = vgetq_lane_u64(ct, 1);
 }
 
+#elif defined(MY_CPU_ARM_OR_ARM64)
+
+static Z7_FORCE_INLINE void AsconEncBlock_NEON(UInt64 state[5], Byte *data)
+{
+  UInt64 block[2];
+  memcpy(block, data, sizeof(block));
+  block[0] ^= state[0];
+  block[1] ^= state[1];
+  memcpy(data, block, sizeof(block));
+  state[0] = block[0];
+  state[1] = block[1];
+}
+
+static Z7_FORCE_INLINE void AsconDecBlock_NEON(UInt64 state[5], Byte *data)
+{
+  UInt64 block[2];
+  memcpy(block, data, sizeof(block));
+  UInt64 p0 = block[0] ^ state[0];
+  UInt64 p1 = block[1] ^ state[1];
+  memcpy(data, &p0, sizeof(p0));
+  memcpy(data + sizeof(p0), &p1, sizeof(p1));
+  state[0] = block[0];
+  state[1] = block[1];
+}
+
 #endif
 
